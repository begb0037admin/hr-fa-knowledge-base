<style>
    .introjs-tooltip
    {
        background: #292929;
        color: #FFFFFF;
        border-radius: 8px;
    }
    .introjs-tooltip .introjs-arrow.bottom,
    .introjs-tooltip .introjs-arrow.bottom-middle,
    .introjs-tooltip .introjs-arrow.bottom-right
    {
        border-top-color: #292929;
    }
    .introjs-tooltip .introjs-arrow.left,
    .introjs-tooltip .introjs-arrow.left-middle,
    .introjs-tooltip .introjs-arrow.left-right
    {
        border-right-color: #292929;
    }
    .introjs-tooltip .introjs-arrow.right,
    .introjs-tooltip .introjs-arrow.right-middle,
    .introjs-tooltip .introjs-arrow.right-right
    {
        border-left-color: #292929;
    }
    .introjs-tooltip .introjs-arrow.top,
    .introjs-tooltip .introjs-arrow.top-middle,
    .introjs-tooltip .introjs-arrow.top-right
    {
        border-bottom-color:#292929;
    }
    /*.introjs-helperLayer
    {
        background: #5C5C5C;
    }*/
    .introjs-skipbutton,
    .introjs-skipbutton:hover
    {    
        font-weight: var(--base-weight-500);
        color: #FFFFFF;
        font-family: none;
        font-size: 24px;
    }
    .introjs-tooltip-header
    {
        padding: 12px 16px;
    }
    .introjs-tooltip
    {
        max-width: 390px !important;
    }
    .introjs-tooltip-title
    {
        font-family: var(--base-fontfamily-onest);
        font-size: 14px;    
        margin-left: -2px;
        font-weight: var(--base-weight-500);
    }
    .introjs-tooltiptext
    {    
        font-family: var(--base-fontfamily-onest);
        padding: 6px 16px;
        font-size: 14px;
        line-height: 20px;    
        width: 360px !important;
    }
    .introjs-tooltiptext a
    {
        color: #3daa6f !important;
    }
    .introjs-tooltiptext a:hover
    {
        color: #5cb786 !important;
    }
    .introjs-tooltiptext img 
    {
        display: block;
    }
    /*.introjs-tooltiptext b
    {
        color: #008F42 !important;
    }*/
    .introjs-bullets
    {
        text-align: left;    
        padding: 10px 16px;
    }
    .introjs-bullets ul li
    {
        margin: 0 4px;
    }
    .introjs-bullets ul li a
    {
        background: #5C5C5C;
        width: 4px;
        height: 4px;
    }
    .introjs-bullets ul li a.active
    {
        width: 4px;
        background: #D6D6D6;
    }
    .introjs-tooltipbuttons
    {    
        display: flex; 
        gap: 4px;
        justify-content: flex-end;
        border: none;    
        margin-top: -36px;
    }
    .introjs-bullets ul > li:only-child,
    .introjs-tooltipbuttons .introjs-disabled
    {
        display: none;
    }
    .introjs-button
    {
        font-family: var(--base-fontfamily-onest);
        display: flex;
        justify-content: center;
        align-items: center;
        border: none;
        text-shadow: none;
        font-size: 12px;
        font-weight: var(--base-weight-400);
        line-height: 16px;
        border-radius: 6px;   
        padding: 2px 8px;
        height: 24px;    
        box-sizing: border-box;
        min-width: 72px;
    }
    .introjs-button:focus
    {
        border: none;
        box-shadow: none;
    }
    .introjs-prevbutton,
    .introjs-disabled + .introjs-button,
    .introjs-disabled + .introjs-button:focus
    {
        background: none;
        color: #D6D6D6;
    }
    .introjs-prevbutton:hover,
    .introjs-prevbutton:focus,
    .introjs-disabled + .introjs-button:hover
    {
        background: #FFFFFF;
        color: #424242;
    }
    .introjs-nextbutton,
    .introjs-nextbutton:focus
    {
        background: #008F42;
        color: #FFFFFF;
    }
    .introjs-nextbutton:hover
    {
        background: #1F9C59;
        color: #FFFFFF;
        box-shadow: 0px 2px 4px 0px rgba(0, 143, 66, 0.16), 0px 0px 2px 0px rgba(0, 143, 66, 0.08);
    }
</style><script id="dxss_CI_960231923" type="text/javascript">//<!--
